---
import Layout from "@layouts/Layout.astro";
import SectionHeader from "@components/SectionHeader.astro";
import IndexRow from "@components/IndexRow.astro";
import publications from "@data/publications.json";
---

<Layout
  title="Publications — Roze"
  description="Published writing and research by Roze."
>
  <section class="mx-auto w-full max-w-[1100px] px-6 py-14 md:px-10">
    <SectionHeader
      title="Publications"
      caption={`[ ${publications.length} works ]`}
      rose
    />
    {
      publications.map((p) => (
        <IndexRow
          href={p.url}
          title={p.title}
          excerpt={p.description}
          meta="↗"
          external
        />
      ))
    }
  </section>
</Layout>
