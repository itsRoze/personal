---
/**
 * Big Anton poster type with the riso off-register overprint: pink + marigold
 * ghost copies offset behind the ink text (mix-blend multiply), like the "ROZE"
 * wordmark in the design. Set ghost={false} for plain poster type.
 */
interface Props {
  text: string;
  as?: "h1" | "h2" | "div";
  ghost?: boolean;
  class?: string;
}

const { text, as: Tag = "h1", ghost = true, class: className = "" } =
  Astro.props;
---

<Tag class={`relative inline-block font-poster uppercase leading-[0.9] ${className}`}>
  {
    ghost && (
      <>
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 -translate-x-[3px] -translate-y-[2px] text-marigold mix-blend-multiply"
        >
          {text}
        </span>
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 translate-x-[4px] translate-y-[3px] text-pink mix-blend-multiply"
        >
          {text}
        </span>
      </>
    )
  }
  <span class="relative">{text}</span>
</Tag>
