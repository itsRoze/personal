---
import Rose from "@components/Rose.astro";

interface Props {
  title: string;
  caption?: string;
  rose?: boolean;
}

const { title, caption, rose = false } = Astro.props;
---

<div class="mb-8 flex items-end justify-between gap-4 border-b-4 border-line pb-4">
  <h2
    class="flex items-center gap-3 font-poster text-3xl leading-none uppercase md:text-5xl"
  >
    {rose && <Rose size={34} />}
    {title}
  </h2>
  {
    caption && (
      <span class="font-mono text-xs tracking-widest whitespace-nowrap text-faint uppercase">
        {caption}
      </span>
    )
  }
</div>
