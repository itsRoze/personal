---
import Rose from "@components/Rose.astro";

const links = [
  { name: "Writing", href: "/blog" },
  { name: "Work", href: "/projects" },
  { name: "Publications", href: "/publications" },
  { name: "About", href: "/about" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<nav
  class="mx-auto flex w-full max-w-[1100px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 pt-7 pb-6 md:px-10"
>
  <a href="/" class="flex items-center gap-2.5">
    <Rose size={30} decorative />
    <span class="font-poster text-2xl tracking-tight uppercase">Roze</span>
    <span class="urdu text-xl leading-none text-pink">روز</span>
  </a>

  <ul
    class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs tracking-wider uppercase"
  >
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "border-b-2 pb-0.5 transition-colors hover:border-pink",
              isActive(link.href)
                ? "border-pink text-ink"
                : "border-transparent text-muted hover:text-ink",
            ]}
          >
            {link.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
