---
import Rose from "@components/Rose.astro";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t-4 border-line">
  <div
    class="mx-auto flex w-full max-w-[1100px] flex-col items-center gap-4 px-6 py-12 text-center md:px-10"
  >
    <Rose size={28} decorative />
    <p class="font-mono text-xs tracking-wider text-faint uppercase">
      © {year} Roze · <span class="urdu text-sm text-pink">روز</span> · built with
      Astro
    </p>
  </div>
</footer>
