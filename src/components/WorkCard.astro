---
/**
 * A work/project card: hard-bordered, content-forward (title, year, description,
 * tech tags, links). The first tag carries the riso accent color so a grid of
 * cards keeps the pink/marigold/indigo rhythm without empty decorative boxes.
 */
interface Props {
  title: string;
  year?: string | number;
  description?: string;
  tags?: string[];
  url?: string;
  github?: string;
  accent?: "indigo" | "pink" | "marigold";
}

const {
  title,
  year,
  description,
  tags = [],
  url,
  github,
  accent = "indigo",
} = Astro.props;

// per-accent chip colors, contrast-checked
const chip = {
  indigo: { bg: "var(--color-indigo)", fg: "#fff" },
  pink: { bg: "var(--color-pink)", fg: "#fff" },
  marigold: { bg: "var(--color-marigold)", fg: "var(--color-ink)" },
}[accent];
const accentStyle = `background:${chip.bg};color:${chip.fg};border-color:${chip.bg};`;
---

<article class="flex flex-col gap-3 border-[3px] border-line bg-paper p-5">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-sans text-lg leading-tight font-extrabold uppercase">
      {title}
    </h3>
    {
      year && (
        <span class="font-mono text-xs whitespace-nowrap text-faint">{year}</span>
      )
    }
  </div>

  {
    description && (
      <p class="flex-1 text-sm leading-relaxed text-muted">{description}</p>
    )
  }

  {
    tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((t, i) => (
          <span
            class="border border-line px-1.5 py-0.5 font-mono text-[10px] tracking-wide text-muted uppercase"
            style={i === 0 ? accentStyle : undefined}
          >
            {t}
          </span>
        ))}
      </div>
    )
  }

  {
    (url || github) && (
      <div class="flex gap-4 pt-1 font-mono text-xs">
        {url && (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-indigo hover:text-pink"
          >
            site ↗
          </a>
        )}
        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-indigo hover:text-pink"
          >
            github ↗
          </a>
        )}
      </div>
    )
  }
</article>
