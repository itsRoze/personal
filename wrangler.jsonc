{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal",
  "compatibility_date": "2026-06-25",
  // Static-assets-only Worker: Astro builds to dist/, no server code (no `main`).
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
